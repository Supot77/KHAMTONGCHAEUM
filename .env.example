# Local: copy to .env.local. Vercel: set these in Project Settings > Environment Variables.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Neon via Vercel Marketplace provides this value. Never prefix secrets with NEXT_PUBLIC_.
# Leave empty for local SQLite development; mandatory for deployed Vercel rooms.
