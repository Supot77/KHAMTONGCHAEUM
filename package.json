    "db:setup": "node scripts/setup-db.mjs",
    "test:rounds": "node --experimental-strip-types --test tests/rounds-duplicates.test.mjs tests/continuation.test.mjs",
    "test:submission": "node --experimental-strip-types --test tests/submission-clock.test.mjs",
    "test:leave": "node --experimental-strip-types --test tests/leave-room.test.mjs",
    "test:dictionary": "node --experimental-strip-types --test tests/dictionary.test.mjs",
